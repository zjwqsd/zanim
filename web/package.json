{
  "name": "@zanim/web",
  "version": "0.1.0-beta.1",
  "type": "module",
  "sideEffects": false,
  "main": "./src/zanim.js",
  "types": "./src/zanim.d.ts",
  "exports": {
    ".": {
      "types": "./src/zanim.d.ts",
      "import": "./src/zanim.js"
    },
    "./zanim_web_core.wasm": "./dist/zanim_web_core.wasm",
    "./ir": {
      "types": "./src/ir.d.ts",
      "import": "./src/ir.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    }
  },
  "files": [
    "src",
    "dist",
    "vite.js",
    "vite.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "node ./test.mjs && node ./rotation.test.mjs && node ./primitive-draw.test.mjs && node ./vite.test.mjs && node ./boolean.test.mjs && node ./move-along.test.mjs && node ./stroke-defaults.test.mjs && node ./scene-viewport.test.mjs && node ./projected-3d-vector.test.mjs && node ./point-light.test.mjs && node ./camera-view-override.test.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "magic-string": "^0.30.17"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "description": "Random-access browser animation runtime and TypeScript authoring API for Zanim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjwqsd/zanim.git",
    "directory": "web"
  },
  "homepage": "https://github.com/zjwqsd/zanim#readme",
  "bugs": {
    "url": "https://github.com/zjwqsd/zanim/issues"
  },
  "keywords": [
    "animation",
    "graphics",
    "canvas",
    "wasm",
    "typst",
    "visualization"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
